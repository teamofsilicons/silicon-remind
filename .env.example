# Silicon Remind local-development configuration.
# Copy to .env and replace every REPLACE_* value before starting the service.
# Never deploy these database credentials or placeholders.

# Process and HTTP server
REMIND_ENVIRONMENT=development
REMIND_BIND_ADDR=127.0.0.1:8080
REMIND_PUBLIC_BASE_URL=http://127.0.0.1:8080
REMIND_REQUEST_TIMEOUT_SECONDS=15
REMIND_MAX_BODY_BYTES=1048576
REMIND_MAX_CONCURRENT_REQUESTS=1024
REMIND_SHUTDOWN_TIMEOUT_SECONDS=30
REMIND_LOG_FILTER=silicon_remind=info,tower_http=info

# Runtime PostgreSQL pool. The worker lease policy requires a nonzero statement timeout.
REMIND_DATABASE_URL=postgres://remind:local-development-only@127.0.0.1:5432/remind
REMIND_DATABASE_MAX_CONNECTIONS=16
REMIND_DATABASE_MIN_CONNECTIONS=1
REMIND_DATABASE_ACQUIRE_TIMEOUT_SECONDS=3
REMIND_DATABASE_STATEMENT_TIMEOUT_SECONDS=10

# Privileged one-shot migrator connection. Keep this distinct in production.
REMIND_MIGRATOR_DATABASE_URL=postgres://remind:local-development-only@127.0.0.1:5432/remind
REMIND_MIGRATOR_DATABASE_MAX_CONNECTIONS=2
REMIND_MIGRATOR_DATABASE_ACQUIRE_TIMEOUT_SECONDS=10
REMIND_MIGRATOR_DATABASE_STATEMENT_TIMEOUT_SECONDS=120

# Optional dedicated shared test database (must differ from the production DB).
REMIND_TEST_DATABASE_URL=postgres://remind:local-development-only@127.0.0.1:5432/remind_testing
REMIND_TEST_MIGRATOR_DATABASE_URL=postgres://remind:local-development-only@127.0.0.1:5432/remind_testing

# IAM opaque-token introspection using Remind's HTTP Basic application credentials.
REMIND_IAM_BASE_URL=https://backend.iam.teamofsilicons.com
REMIND_IAM_APP_ID="tos>remind"
REMIND_IAM_APP_SECRET=REPLACE_WITH_IAM_APPLICATION_SECRET
REMIND_IAM_REQUEST_TIMEOUT_MS=3000

# IAM Application webhook credentials validated by the official SDK. HMAC uses
# complete literal whs_ credential bytes. Retain versions during IAM rotation.
REMIND_IAM_WEBHOOK_KEYRING={"1":"REPLACE_WITH_IAM_WHS_WEBHOOK_SIGNING_SECRET"}

# Bearer credential accepted only by Remind's internal API.
REMIND_INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_API_TOKEN

# AES-256-GCM keyring. Values are unpadded base64url-encoded 32-byte keys.
# Worker sweeps rewrap active destinations to the current version. Retain old
# versions until no active or disabled row references them.
REMIND_ENCRYPTION_CURRENT_VERSION=1
REMIND_ENCRYPTION_KEYRING={"1":"REPLACE_WITH_UNPADDED_BASE64URL_32_BYTE_KEY"}

# Outbound webhook HTTP bounds. Each Silicon supplies its own absolute HTTP(S)
# endpoint through the authenticated webhook configuration API.
REMIND_WEBHOOK_CONNECT_TIMEOUT_MS=2000
REMIND_WEBHOOK_REQUEST_TIMEOUT_MS=10000
REMIND_WEBHOOK_MAX_RESPONSE_BYTES=65536

# Durable scheduler and delivery worker. The operational listener is
# unauthenticated; expose it only to local probes and the metrics collector.
REMIND_WORKER_OPERATIONAL_BIND_ADDR=127.0.0.1:9090
REMIND_WORKER_BATCH_SIZE=100
REMIND_WORKER_MAX_DELIVERY_CONCURRENCY=16
REMIND_WORKER_POLL_INTERVAL_MS=500
# Must exceed the webhook timeout, two database operation budgets, polling, and
# the built-in five-second lease safety margin.
REMIND_WORKER_LEASE_SECONDS=60

# Webhook delivery retry policy
REMIND_RETRY_MAX_ATTEMPTS=8
REMIND_RETRY_BASE_DELAY_SECONDS=30
REMIND_RETRY_MAX_DELAY_SECONDS=3600
REMIND_RETRY_JITTER_PERCENT=20

# Retention, destination rewrap, and cleanup. Schedule and disabled-destination
# retention is a fixed 45-day product invariant enforced by the database.
REMIND_IDEMPOTENCY_RETENTION_HOURS=24
REMIND_RETENTION_SWEEP_INTERVAL_SECONDS=60
REMIND_RETENTION_BATCH_SIZE=500
