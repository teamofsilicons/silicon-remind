# syntax=docker/dockerfile:1.7
# BACKEND_IMAGE is the CA-bearing runtime image built with Dockerfile.runtime.
ARG BACKEND_IMAGE
FROM ${BACKEND_IMAGE}
USER root
RUN apt-get update \
    && apt-get install --yes --no-install-recommends python3 python3-boto3 postgresql-client \
    && rm -rf /var/lib/apt/lists/*
COPY --chown=10001:10001 deploy/aws/bootstrap-task.py /opt/silicon-remind/bootstrap-task.py
COPY --chown=10001:10001 deploy/runtime-grants.sql /opt/silicon-remind/runtime-grants.sql
USER 10001:10001
ENTRYPOINT ["python3", "/opt/silicon-remind/bootstrap-task.py"]
CMD []
