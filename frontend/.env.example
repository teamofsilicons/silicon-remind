# Public origin must match the browser origin and forwarded Host exactly.
FRONTEND_ORIGIN=http://127.0.0.1:4330
IAM_AUTH_ORIGIN=https://auth.iam.teamofsilicons.com
REMIND_UPSTREAM=https://backend.remind.teamofsilicons.com
# Required for npm start: generate 32 random bytes encoded as base64url.
# Dev creates a private, persistent .sessions/dev.key when omitted.
# SESSION_KEY=
SESSION_DIRECTORY=.sessions
PORT=4330
HOST=127.0.0.1
