{
  "name": "@silicon-remind/web",
  "version": "0.6.0",
  "private": true,
  "description": "Silicon Remind: reminders, delivery history and precise sharing.",
  "scripts": {
    "dev": "next dev --port ${PORT:-4180}",
    "build": "next build",
    "start": "next start --port ${PORT:-4180}",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings=0 .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test --project=e2e",
    "screens": "playwright test --project=screens"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.21",
    "@radix-ui/react-checkbox": "1.3.12",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@teamofsilicons/space-station-web": "0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jose": "6.2.12",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0"
}
