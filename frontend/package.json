{
  "name": "silicon-remind-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4330 --strictPort",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && node scripts/build-server.mjs",
    "start": "node dist/server/node.js",
    "test": "node --test server/*.test.ts"
  },
  "dependencies": {
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14"
  },
  "engines": {
    "node": ">=24"
  }
}
